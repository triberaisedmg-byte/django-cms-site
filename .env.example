# ==============================================================================
# TribeRaised Django CMS Marketing Site - Environment Configuration
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1],web

# Networking & Ports
PORT=8001
SITE_ID=1

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 18 default with SQLite fallback)
# ------------------------------------------------------------------------------
# Set USE_SQLITE=True to force SQLite for local development or testing without Postgres
USE_SQLITE=False

# For Local Host CLI Development & Testing (Outside Docker):
# Connects to shared PostgreSQL instance mapped to localhost:5432 / localhost:5444
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=triberaised_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/triberaised_cms

# For Docker Compose (Internal Container Network):
# Inside triberaised_tr-network, web resolves tr-profile-postgres over internal DNS
DOCKER_POSTGRES_HOST=tr-profile-postgres

# Security & SSL (Production only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,https://triberaised.com

# Media & Static Storage
STATIC_URL=/static/
MEDIA_URL=/media/

# Google Cloud Storage (GCS) Media Backend
USE_GCS_MEDIA=False
GS_BUCKET_NAME=triberaised-marketing-media
GS_MEDIA_PREFIX=media
GS_CACHE_CONTROL=public, max-age=31536000, immutable
GS_CUSTOM_ENDPOINT=

# MinIO / Local Disk Fallback Storage
USE_MINIO=False
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=triberaised-media
